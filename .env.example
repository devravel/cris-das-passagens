# Database (Supabase PostgreSQL — use pooler URL in production when possible)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase public key (anon or publishable — never commit the service role key here)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Optional alias supported by the app
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Supabase service role (server-only — required for admin image uploads)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin JWT session secret (min. 32 random characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Canonical public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://crisdaspassagens.com.br"
