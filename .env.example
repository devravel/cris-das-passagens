# Database (Supabase PostgreSQL — pooler for app runtime)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Direct Postgres connection (required for Prisma migrations — port 5432)
# Supabase Dashboard → Project Settings → Database → Connection string → Direct
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase public key (anon or publishable — never commit the service role key here)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Optional alias supported by the app
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Supabase service role (server-only — required for admin image uploads)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin JWT session secret (min. 32 random characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Canonical public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://crisdaspassagens.com.br"

# Optional: Google Places API for /destinos gallery (falls back to stock photos if unset)
# GOOGLE_PLACES_API_KEY="your-google-places-api-key"
# GOOGLE_BUSINESS_PLACE_ID="your-google-place-id"
