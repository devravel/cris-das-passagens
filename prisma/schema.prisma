// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id                  String     @id @default(cuid())
  title               String
  slug                String     @unique
  excerpt             String     @db.Text
  content             String     @db.Text
  coverImage          String
  published           Boolean    @default(false)
  featuredOnHomepage  Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tags                PostTag[]
  likes               PostLike[]

  @@index([published, createdAt])
  @@index([featuredOnHomepage, published, createdAt])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  posts     PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  clientId  String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, clientId])
  @@index([postId])
}

enum PackageType {
  PACKAGE_COMPLETE
  FLIGHT
  HOTEL
  TICKET
  CRUISE
}

enum PackageCategory {
  NATIONAL
  INTERNATIONAL
}

enum PackagePriceScope {
  PER_PERSON
  COUPLE
  FAMILY
}

model Package {
  id                    String           @id @default(cuid())
  title                 String
  slug                  String           @unique
  shortDescription      String?          @db.Text
  destination           String
  image                 String
  type                  PackageType
  category              PackageCategory?
  price                 Decimal          @db.Decimal(10, 2)
  oldPrice              Decimal?         @db.Decimal(10, 2)
  priceScope            PackagePriceScope?
  installmentText       String?
  highlightInstallments Boolean          @default(false)
  airline               String?
  hotelName             String?
  includedItems         String[]         @default([])
  departureCity         String?
  departureDate         DateTime?        @db.Date
  returnDate            DateTime?        @db.Date
  daysCount             Int?
  nightsCount           Int?
  showOnLandingPage     Boolean          @default(true)
  active                Boolean          @default(true)
  featured              Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([active, createdAt])
  @@index([featured, active, createdAt])
  @@index([type, active])
  @@index([showOnLandingPage, active, type])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum ReiDaCopaKeywordStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReiDaCopaParticipant {
  id                 String   @id @default(cuid())
  registrationNumber Int      @unique @default(autoincrement())
  name               String
  phone              String
  instagram          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  keywordSubmissions ReiDaCopaKeywordSubmission[]
  ranking            ReiDaCopaRanking?

  @@unique([phone])
  @@unique([instagram])
  @@index([name])
  @@index([createdAt])
  @@map("rei_da_copa_participants")
}

model ReiDaCopaKeyword {
  id        String   @id @default(cuid())
  value     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("rei_da_copa_keywords")
}

model ReiDaCopaKeywordSubmission {
  id            String                 @id @default(cuid())
  participantId String
  keyword       String
  status        ReiDaCopaKeywordStatus @default(PENDING)
  createdAt     DateTime               @default(now())

  participant ReiDaCopaParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([status, createdAt])
  @@index([keyword])
  @@map("rei_da_copa_keyword_submissions")
}

model ReiDaCopaRanking {
  id            String   @id @default(cuid())
  participantId String   @unique
  points        Int      @default(0)
  position      Int
  updatedAt     DateTime @updatedAt

  participant ReiDaCopaParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([position])
  @@map("rei_da_copa_ranking")
}

model ReiDaCopaSettings {
  id                String    @id @default("default")
  startDate         DateTime? @db.Date
  endDate           DateTime? @db.Date
  firstPlacePrize   String?
  secondPlacePrize  String?
  thirdPlacePrize   String?
  regulation        String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("rei_da_copa_settings")
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  name          String
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)
  isActive      Boolean            @default(true)
  maxUses       Int?
  currentUses   Int                @default(0)
  expiresAt     DateTime?
  description   String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  redemptions   CouponRedemption[]

  @@index([isActive])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id           String   @id @default(cuid())
  couponId     String
  packageTitle String?
  usedAt       DateTime @default(now())
  coupon       Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([usedAt])
  @@map("coupon_redemptions")
}
